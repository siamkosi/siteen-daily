# Use a NEW development Supabase project. Never paste service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for a public deployment, e.g. https://daily.example.com (no path).
# Set http://127.0.0.1:3000 for local use. Forwarded headers are not trusted.
APP_ORIGIN=
# Google OAuth Client ID/Secret are configured in Supabase Auth, not NEXT_PUBLIC_*.
# PDF defaults to msedge on Windows, Playwright-managed Chromium on Linux/macOS.
# PDF_BROWSER=chromium
# Production Linux requires Chromium sandbox and a compatible host/container.
# PDF_CHROMIUM_SANDBOX=true
