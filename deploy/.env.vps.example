# Copy to deploy/.env.vps; keep this local file private and outside image context.
# NEXT_PUBLIC values are baked into the build. Rebuild when changing either.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
APP_ORIGIN=https://daily.example.com
SITEEN_RELEASE=local
SITEEN_LOCAL_PORT=3000
# Initial limits only; confirm available VPS resources and perform load tests.
SITEEN_MEMORY_LIMIT=2g
SITEEN_CPU_LIMIT=2
SITEEN_PID_LIMIT=512
